{
  "name": "tatiane",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "psql \"${TEST_ADMIN_URL:-postgres://postgres@localhost:5432/postgres}\" -qc \"drop database if exists agenda_test\" -c \"create database agenda_test\" && DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@localhost:5432/agenda_test} tsx scripts/migrate.ts && POSTGRES_URL=${TEST_DATABASE_URL:-postgres://postgres@localhost:5432/agenda_test} vitest run tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@vercel/functions": "^3.11.4",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}

# Banco de dados Postgres (na Vercel, a integração do Supabase preenche estas variáveis sozinha)
POSTGRES_URL=postgres://usuario:senha@host:6543/postgres          # conexão com pooler (usada pelo app)
POSTGRES_URL_NON_POOLING=postgres://usuario:senha@host:5432/postgres  # conexão direta (usada nas migrations)
# Alternativa para desenvolvimento local:
# DATABASE_URL=postgres://postgres@localhost:5432/agenda

# Endereço público do sistema (opcional na Vercel; usado nos links dos e-mails)
APP_URL=http://localhost:3000

# Se o domínio for só de um negócio, a raiz "/" abre direto a página de agendamento dele
# DEFAULT_ORG_SLUG=tatiane-by-lash

# Segredo do cron de lembretes (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=troque-por-um-valor-aleatorio

# E-mail (Resend). Sem a chave, as mensagens são registradas como "simuladas" no painel.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Tatiane By Lash <agenda@seudominio.com.br>"
